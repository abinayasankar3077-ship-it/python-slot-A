import re

POSITIVE_WORDS = {"clean", "fast", "helpful", "improved", "good", "great"}
NEGATIVE_WORDS = {"smoke", "bad", "slow", "dirty", "poor"}
NEGATORS = {"not", "no", "never", "n't"}


def score(text):
    # Clean punctuation and split text into lowercase words
    words = re.findall(r"[a-z']+", text.lower())
    total = 0

    for i, word in enumerate(words):
        val = 0
        if word in POSITIVE_WORDS:
            val = 1
        elif word in NEGATIVE_WORDS:
            val = -1

        # If the previous word is a negator, flip the sign; add it to total
        if i > 0 and words[i - 1] in NEGATORS:
            val = -val

        total += val

    return total


def label(text):
    s = score(text)
    return "positive" if s > 0 else "negative" if s < 0 else "neutral"


for c in [
    "Roads are clean and the bus was fast.",
    "Smoke from the factory, air is bad.",
    "The staff were not helpful.",
    "Not bad, service improved.",
]:
    print(f"{label(c):8} | {c}")

